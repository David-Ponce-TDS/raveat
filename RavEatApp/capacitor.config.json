{
    "appId": "app.raveat",
    "appName": "RavEat",
    "webDir": "dist",
    "server": {
        "androidScheme": "http",
        "cleartext": true
    },
    "plugins": {
        "LocalNotifications": {
            "smallIcon": "ic_stat_notify",
            "iconColor": "#3880FF"
        },
        "SplashScreen": {
            "launchAutoHide": true,
            "launchFadeOutDuration": 300,
            "androidScaleType": "CENTER_CROP",
            "showSpinner": false
        }
    }
}

# Plantilla de la firma de release. Copiala como keystore.properties, que no se versiona, y
# completala con los datos de tu keystore:
#   Copy-Item .\keystore.properties.example .\keystore.properties
#
# storeFile es relativo a la carpeta android/.
storeFile=raveat-release.jks
storePassword=CAMBIAR
keyAlias=raveat
keyPassword=CAMBIAR

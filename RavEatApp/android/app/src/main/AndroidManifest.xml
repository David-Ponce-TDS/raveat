<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- `usesCleartextTraffic` en false y con `tools:replace` porque un modulo generado por
         Capacitor lo declara en true, y sin el replace la fusion se queda con el suyo. Android lo
         ignora en favor de `networkSecurityConfig`, pero es lo primero que se mira al revisar la
         declaracion de "Seguridad de los datos" de Play, y tiene que decir lo mismo. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        tools:replace="android:usesCleartextTraffic"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App Link verificado: lo que lleva el QR del pedido. Es una URL https comun, y esa es
                 la gracia: la camara del sistema, WhatsApp o el navegador la abren igual.
                 `autoVerify` hace que Android baje https://<host>/.well-known/assetlinks.json al
                 instalar y compare la huella del certificado que firmo el APK: si coincide, el
                 enlace abre la app sin preguntar; si no (APK de debug, huella sin publicar), abre
                 el navegador, que muestra la misma pagina. Los dos caminos terminan en el pedido.
                 El host va escrito aca y no en una variable: es parte de la identidad de la app
                 publicada, y cambiarlo obliga a republicar el APK. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="raveat.runasp.net" android:pathPrefix="/p/" />
            </intent-filter>
        </activity>
        <!-- La camara entrega la foto a la webview por este proveedor: sin el, falla al sacarla. -->
        <!-- Icono y color de las push de FCM: sin el icono chico (silueta blanca sobre fondo
             transparente), Android muestra en la barra de estado el glifo generico del sistema, un
             circulo. El PNG sale de recursos/iconos/ic_stat_notify-fuente.png con el Asset Studio. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />
        <!-- Canal predeterminado de las push: el de importancia alta que crea la app al arrancar
             (notificaciones_nativas_service). Sin esto FCM usa su canal callado y la push no
             aparece como banner. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="avisos" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Galeria en Android 12 o anterior; desde Android 13 el selector no pide permiso. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Las dos precisiones: Android 12+ deja dar la aproximada, y para una direccion de entrega
         alcanza. POST_NOTIFICATIONS no se declara aca: lo aporta el plugin al fusionar. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
</manifest>

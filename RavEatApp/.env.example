# Plantilla de variables del frontend. Copiala como .env y completa lo tuyo:
#   Copy-Item .\.env.example .\.env
#
# Que archivo gana (orden de prioridad creciente de Vite):
#   .env  <  .env.local  <  .env.[modo]  <  .env.[modo].local
# En `npm run dev` el modo es "development", asi que .env.development pisa a .env.local.
# En `npm run build` el modo es "production": .env.development NO se carga, .env.local SI.
#
# Versionado: .env.example.  Locales (ignorados): .env y .env.local.

# --- URL de la API -----------------------------------------------------------
# Con el modo debug ACTIVO (valor por defecto) la app ignora VITE_API_URL y usa
# VITE_API_URL_DEBUG. Ver la seccion "Depuracion" del README.

# URL que se usa solo cuando el modo debug esta desactivado.
VITE_API_URL=http://localhost:5080

# 'false' (exactamente esa cadena) apaga el modo debug. Cualquier otro valor lo deja activo.
# Ponelo en false para trabajar en el navegador contra la API local.
# VITE_DEBUG_ACTIVADO=false

# URL usada mientras el modo debug esta activo: la IP LAN de TU maquina, para que un
# telefono fisico pueda alcanzar la API (en el telefono, localhost es el propio telefono).
# La averiguas con `ipconfig` y cambia segun la red a la que estes conectado.
# VITE_API_URL_DEBUG=http://TU_IP_LAN:5080

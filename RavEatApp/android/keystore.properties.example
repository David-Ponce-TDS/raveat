# Plantilla de la firma de release. Copiala como keystore.properties, que no se versiona, y
# completala con los datos de tu keystore:
#   Copy-Item .\keystore.properties.example .\keystore.properties
#
# El keystore se genera UNA vez y se guarda para siempre: perderlo es perder la posibilidad de
# actualizar la app publicada. Desde la carpeta android/:
#   keytool -genkeypair -v -keystore raveat-release.jks -alias raveat -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile es relativo a la carpeta android/.
storeFile=raveat-release.jks
storePassword=CAMBIAR
keyAlias=raveat
keyPassword=CAMBIAR

# El build que se firma: `npm run build:release` (vite build --mode release).
# Se versiona porque no tiene secretos: es la definicion reproducible del instalable.

# Apaga el modo debug: el APK no busca la IP de ninguna PC.
VITE_DEBUG_ACTIVADO=false

# Vacia a proposito: pisa la VITE_API_URL del .env local y deja que decida la URL de produccion
# de src/config/debug.js.
VITE_API_URL=

# Vacia tambien: la IP de la LAN del .env local no tiene que quedar escrita dentro del APK.
VITE_API_URL_DEBUG=
